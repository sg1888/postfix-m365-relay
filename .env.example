# Copy to `.env` (same directory as compose.yaml) and adjust. Docker Compose
# reads `.env` automatically. `.env` itself is gitignored; this example is safe
# to commit.

# Which container image to run. Compose substitutes ${MAIL_IMAGE} in compose.yaml.
#
# CPU COMPATIBILITY — pick the tag your CPU can run (see docs/BASE-IMAGE.md):
#   :latest              needs x86-64-v3 (AVX2, ~2013+ full CPUs). Fastest.
#   :latest-x86-64-v2    needs only x86-64-v2 (SSE4.2, ~2009+). Widest AlmaLinux
#                        coverage — pick this on a VM or a budget/older CPU.
#
# Not sure? Run:  grep -o -m1 avx2 /proc/cpuinfo   (empty output => use v2)
#
# The v2 tag is the safe default: it runs on v2 AND v3 CPUs, and the performance
# difference is irrelevant for a mail relay. Switch to :latest only if you know
# your CPU has AVX2 and want the marginal gain. Pin a version (e.g.
# :1.0.0-x86-64-v2) instead of a floating tag for reproducible deploys.
MAIL_IMAGE=docker.io/sg1888/postfix-m365-relay:latest-x86-64-v2
