# Copy to `.env` (same directory as compose.yaml) and adjust. Docker Compose
# reads `.env` automatically. `.env` itself is gitignored; this example is safe
# to commit.

# Which container image to run. Compose substitutes ${MAIL_IMAGE} in compose.yaml.
#
# The default `:latest` is the Ubuntu-based build and runs on ANY x86-64 CPU
# (including virtual machines with the default QEMU/KVM CPU, and budget chips like
# Celeron/Atom/N-series) plus arm64. There is nothing to pick — leave it as-is
# and it works everywhere.
#
# Optimized AlmaLinux builds are available if you want them (see docs/BASE-IMAGE.md):
#   :latest  / :ubuntu   Ubuntu, universal. amd64 + arm64. (default)
#   :alma-v3             AlmaLinux, needs x86-64-v3 (AVX2, ~2013+). amd64 + arm64.
#   :alma-v2             AlmaLinux, needs x86-64-v2 (SSE4.2, ~2009+). amd64 only.
#
# Pin a version (e.g. :1.0.0, or :1.0.0-alma-v2) instead of a moving tag for
# reproducible deploys.
MAIL_IMAGE=docker.io/sg1888/postfix-m365-relay:latest
