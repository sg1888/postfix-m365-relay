# PROTOTYPE — Ubuntu-based build for universal CPU compatibility.
#
# WHY THIS EXISTS (read docs/BASE-IMAGE.md for the full reasoning):
#   The primary image is built on AlmaLinux 10, whose minimum CPU baseline is
#   x86-64-v3 (AVX2). AlmaLinux ships an x86-64-v2 rebuild, so we publish a
#   `-x86-64-v2` tag too — but BOTH still require at least SSE4.2, and the
#   default QEMU/KVM virtual CPU (`qemu64`/`kvm64`) advertises less than that.
#   Result: on a stock-CPU VM, neither AlmaLinux image boots ("CPU does not
#   support x86-64-v3"), and Docker cannot auto-pick a lower variant because it
#   does not select amd64 microarchitecture levels at pull time.
#
#   Ubuntu is compiled at the ORIGINAL x86-64 baseline (v1), so ONE amd64 image
#   runs on every x86-64 CPU — including the default QEMU virtual CPU — with no
#   v2/v3 tag split and nothing to auto-detect. arm64 is published alongside.
#
# WHY UBUNTU AND NOT DEBIAN:
#   sasl-xoauth2 is NOT in Debian stable/testing (only `experimental`, 0.20).
#   The maintainer distributes recent versions through a Launchpad PPA that
#   builds for Ubuntu series. We therefore base on Ubuntu 24.04 LTS (noble) and
#   obtain the plugin without compiling — see SXO_SOURCE below.
#
# STATUS: prototype. It has NOT yet passed the offline suite in docs/TESTING.md.
#   Known port items still to verify (see docs/BASE-IMAGE.md "Porting checklist"):
#     - Cyrus SASL config path differs on Ubuntu (multiarch sasl2 dir; smtpd.conf
#       discovery). Verify the XOAUTH2 mechanism is offered.
#     - The runtime scripts contain rpm-based checks (verify-relay.sh reads
#       `rpm -q ca-certificates` for CA-bundle age). Those must be ported to dpkg
#       or they will report a false failure on Ubuntu.
ARG BASE_IMAGE=ubuntu:24.04
FROM ${BASE_IMAGE}

# How to obtain the sasl-xoauth2 plugin. Three documented options, so the choice
# is explicit and auditable rather than implied:
#   vendored (DEFAULT) - install the .deb committed under vendor/sasl-xoauth2/.
#                        No build-time dependency on the PPA staying online, and
#                        the exact bytes are pinned by SHA256SUMS. This is the
#                        supply-chain-safe default.
#   ppa      - add ppa:sasl-xoauth2/stable and apt-install the current version.
#              Always fresh, but the build FAILS if the PPA is offline/removed,
#              and you trust a single-maintainer archive at build time.
#   source   - compile from a pinned upstream tag. No third-party binary at all,
#              at the cost of a build toolchain and the maintenance the project
#              otherwise avoids. Provided for those who require from-source builds.
ARG SXO_SOURCE=vendored
# Upstream release tag used by the `source` mode. Matches the vendored version.
ARG SXO_SOURCE_REF=release-0.27
# buildx populates TARGETARCH automatically (amd64 | arm64).
ARG TARGETARCH

ENV DEBIAN_FRONTEND=noninteractive

# Base runtime packages. libsasl2-modules provides the conventional PLAIN/LOGIN
# plugins (Cyrus SASL will not advertise a mechanism list without at least one
# present); sasl2-bin provides saslpasswd2/pluginviewer; netcat-openbsd gives the
# `nc` the healthcheck uses; iproute2 gives `ip` used by render-config.sh.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      postfix libsasl2-2 libsasl2-modules sasl2-bin ca-certificates \
      python3 python3-cryptography openssl curl netcat-openbsd iproute2 tzdata \
 && rm -rf /var/lib/apt/lists/*

# --- sasl-xoauth2 plugin: one of three sourcing modes -----------------------
COPY vendor/sasl-xoauth2/ /tmp/vendor-sasl-xoauth2/
RUN set -eux; \
  case "$SXO_SOURCE" in \
    vendored) \
      cd /tmp/vendor-sasl-xoauth2; \
      # Verify the pinned checksum before trusting the file, then install just
      # this architecture's .deb and let apt resolve its runtime dependencies.
      deb="$(ls sasl-xoauth2_*_"${TARGETARCH}".deb)"; \
      grep -F "$deb" SHA256SUMS | sha256sum -c -; \
      apt-get update; \
      apt-get install -y --no-install-recommends "./$deb"; \
      rm -rf /var/lib/apt/lists/*; \
      ;; \
    ppa) \
      apt-get update; \
      apt-get install -y --no-install-recommends software-properties-common; \
      add-apt-repository -y ppa:sasl-xoauth2/stable; \
      apt-get update; \
      apt-get install -y --no-install-recommends sasl-xoauth2; \
      apt-get purge -y software-properties-common; apt-get autoremove -y; \
      rm -rf /var/lib/apt/lists/*; \
      ;; \
    source) \
      apt-get update; \
      apt-get install -y --no-install-recommends \
        git cmake g++ make pkg-config libsasl2-dev libcurl4-openssl-dev libjsoncpp-dev; \
      git clone --depth 1 --branch "$SXO_SOURCE_REF" \
        https://github.com/tarickb/sasl-xoauth2.git /tmp/sxo-src; \
      cmake -S /tmp/sxo-src -B /tmp/sxo-build \
        -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_SYSCONFDIR=/etc \
        -DCMAKE_BUILD_TYPE=Release; \
      cmake --build /tmp/sxo-build --target install; \
      rm -rf /tmp/sxo-src /tmp/sxo-build; \
      apt-get purge -y git cmake g++ make pkg-config libsasl2-dev \
        libcurl4-openssl-dev libjsoncpp-dev; \
      apt-get autoremove -y; rm -rf /var/lib/apt/lists/*; \
      ;; \
    *) echo "unknown SXO_SOURCE=$SXO_SOURCE (expected vendored|ppa|source)" >&2; exit 1 ;; \
  esac; \
  rm -rf /tmp/vendor-sasl-xoauth2; \
  # Prove the plugin is present and discoverable before the build succeeds. The
  # sasl2 plugin directory is multiarch on Ubuntu (/usr/lib/<triplet>/sasl2).
  saslauthd_dir="$(dirname "$(find /usr/lib -name 'libsasl-xoauth2.so*' -print -quit)")"; \
  test -n "$saslauthd_dir"; \
  echo "sasl-xoauth2 plugin installed in: $saslauthd_dir"; \
  command -v saslpasswd2 >/dev/null; \
  python3 -c 'import cryptography'

# Keep the packaged Postfix defaults somewhere durable so both normal and
# read-only (tmpfs /etc/postfix) boots can restore them.
RUN cp -a /etc/postfix /usr/share/postfix-defaults \
 && install -d -m 0755 /etc/postfix/sasl /usr/local/libexec/mail-relay \
      /usr/share/postfix-m365-relay /config \
 && printf '%s\n' \
      'pwcheck_method: auxprop' \
      'auxprop_plugin: sasldb' \
      'sasldb_path: /run/mail-relay/sasldb2' \
      'mech_list: PLAIN LOGIN' \
      > /etc/postfix/sasl/smtpd.conf \
 && printf '%s\n' \
      '{"client_id":"unused-app-only-flow","client_secret":"","token_endpoint":"http://127.0.0.1:9/sasl-xoauth2-must-not-refresh","always_log_to_syslog":"no","log_to_syslog_on_failure":"yes","log_full_trace_on_failure":"no"}' \
      > /etc/sasl-xoauth2.conf \
 && ln -s /run/mail-relay/log /var/log/mail-relay

COPY build/postfix-m365-relay/entrypoint.sh build/postfix-m365-relay/relay-supervisor.sh \
     build/postfix-m365-relay/relay-users build/postfix-m365-relay/relay-admin \
     build/postfix-m365-relay/export-cert /usr/local/bin/
COPY build/postfix-m365-relay/render-config.sh build/postfix-m365-relay/verify-relay.sh \
     build/postfix-m365-relay/rotate-inbound-tls.sh build/postfix-m365-relay/alert.sh \
     scripts/alert-event.py \
     scripts/refresh-smtp-token.py \
     scripts/rotate-smtp-relay-cert.py /usr/local/libexec/mail-relay/
COPY mail-relay.conf.example /usr/share/postfix-m365-relay/mail-relay.conf.example
RUN chmod 0755 /usr/local/bin/entrypoint.sh /usr/local/bin/relay-supervisor.sh \
      /usr/local/bin/relay-users /usr/local/bin/relay-admin /usr/local/bin/export-cert \
      /usr/local/libexec/mail-relay/*

# Documentation only; the relay is reachable on the mail network and publishes
# no host port. 2525 rather than 587 so the container needs no
# CAP_NET_BIND_SERVICE.
EXPOSE 2525

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
