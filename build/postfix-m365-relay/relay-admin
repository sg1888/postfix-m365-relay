#!/usr/bin/env bash
# Safe entry point for documented `docker exec` administration.
#
# PID 1 loads /config/mail-relay.conf and exports it only to its own children.
# Docker creates an exec session from the container's original image/runtime
# environment; it cannot inherit later exports from PID 1. The first live
# `--list-keys` test consequently failed with MAIL_RELAY_TENANT unset, and an
# exec-session `date` ignored the configured TZ. This wrapper deliberately
# repeats the small data parser used at boot, then invokes one allowlisted tool.
#
# Never replace this parser with `source` or `eval`. Display names and other
# values are administrator-controlled data and may legitimately contain dollar
# signs, quotes, backslashes, brackets, or text that resembles shell syntax.
set -euo pipefail

CONFIG_FILE=${MAIL_CONFIG_FILE:-/config/mail-relay.conf}

usage() {
  cat >&2 <<'EOF'
Usage:
  relay-admin verify
  relay-admin keys
  relay-admin export-cert
  relay-admin rotate [--force] [--dry-run] [--validity DAYS] [--renew-at DAYS]
                     [--grace-days DAYS] [--to ADDRESS]
  relay-admin remove-key KEY-ID
  relay-admin reset-oauth-cert
  relay-admin users
EOF
  exit 64
}

allowed_config_name() {
  [[ $1 == MAIL_* || $1 == POSTFIX_* || $1 == TZ || $1 == RELAY_PORT ]]
}

variable_is_set() {
  declare -p "$1" >/dev/null 2>&1
}

load_config_file() {
  local line name value
  [[ -r $CONFIG_FILE ]] || return 0
  while IFS= read -r line || [[ -n $line ]]; do
    line=${line%$'\r'}
    [[ -n $line && $line != \#* ]] || continue
    [[ $line == *=* ]] || {
      printf 'relay-admin: %s contains a non-comment line without =\n' "$CONFIG_FILE" >&2
      exit 65
    }
    name=${line%%=*}; value=${line#*=}
    [[ $name =~ ^[A-Z][A-Z0-9_]*$ ]] || {
      printf 'relay-admin: %s contains an invalid variable name\n' "$CONFIG_FILE" >&2
      exit 65
    }
    allowed_config_name "$name" || {
      printf 'relay-admin: %s may set only MAIL_*, POSTFIX_*, TZ, or RELAY_PORT\n' "$CONFIG_FILE" >&2
      exit 65
    }
    # Matching outer quotes are convenience delimiters only. No interpolation,
    # escaping, command substitution, or backslash processing occurs inside.
    if (( ${#value} >= 2 )) && { [[ $value == \"*\" ]] || [[ $value == \'*\' ]]; }; then
      value=${value:1:${#value}-2}
    fi
    # Docker/orchestrator variables retain precedence over the persistent file,
    # including an explicitly empty value. This is identical to normal boot.
    if ! variable_is_set "$name"; then
      printf -v "$name" '%s' "$value"
      export "$name"
    fi
  done < "$CONFIG_FILE"
}

load_config_file
[[ $# -ge 1 ]] || usage
command_name=$1
shift

case "$command_name" in
  verify)
    [[ $# -eq 0 ]] || usage
    exec /usr/local/libexec/mail-relay/verify-relay.sh
    ;;
  keys)
    [[ $# -eq 0 ]] || usage
    exec /usr/local/libexec/mail-relay/rotate-smtp-relay-cert.py --list-keys
    ;;
  export-cert)
    # Emit the PUBLIC OAuth certificate for upload to the Entra app. The private
    # key is never touched; the bare `export-cert` command is the same script.
    [[ $# -eq 0 ]] || usage
    exec /usr/local/bin/export-cert
    ;;
  users)
    [[ $# -eq 0 ]] || usage
    exec /usr/local/bin/relay-users list
    ;;
  remove-key)
    # Graph key IDs are UUIDs. Validate before calling a state-changing command
    # so a typo cannot be reinterpreted as another Python option. The override
    # that would delete another instance's certificate is deliberately NOT exposed
    # here: through this admin surface, a foreign or live credential is always
    # refused. An operator who truly must override runs the script directly.
    [[ $# -eq 1 && $1 =~ ^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{4}-[0-9A-Fa-f]{12}$ ]] || usage
    exec /usr/local/libexec/mail-relay/rotate-smtp-relay-cert.py --remove-key "$1"
    ;;
  reset-oauth-cert)
    # Regenerate the live OAuth certificate from scratch and require re-upload to
    # Entra. Deliberately destructive; the outgoing pair is kept as .previous by
    # the script. This is the interactive equivalent of dropping the
    # /config/reset-oauth-cert sentinel file.
    [[ $# -eq 0 ]] || usage
    exec /usr/local/libexec/mail-relay/rotate-smtp-relay-cert.py --reset --yes
    ;;
  rotate)
    # Passing an array to one fixed executable is not shell evaluation, but the
    # rotation program also has offline generation and arbitrary-path options.
    # Those are intentionally excluded from remote administration because they
    # could overwrite credentials. Only normal lifecycle tuning is allowlisted.
    safe_args=()
    while (( $# )); do
      case "$1" in
        --force|--dry-run)
          safe_args+=("$1"); shift
          ;;
        --validity|--renew-at|--grace-days)
          [[ $# -ge 2 && $2 =~ ^[0-9]+$ ]] || usage
          safe_args+=("$1" "$2"); shift 2
          ;;
        --to)
          [[ $# -ge 2 && -n $2 && $2 != -* ]] || usage
          safe_args+=("$1" "$2"); shift 2
          ;;
        *) usage ;;
      esac
    done
    exec /usr/local/libexec/mail-relay/rotate-smtp-relay-cert.py "${safe_args[@]}"
    ;;
  *) usage ;;
esac
