# =============================================================================
# postfix-m365-relay configuration
#
# This file is copied to /config/mail-relay.conf the first time the container
# starts. Fill in the values below and restart. Anything not listed here keeps a
# sensible default; every available setting is documented in docs/CONFIGURATION.md.
#
# Secrets (private keys, passwords) are never written in this file -- they are
# mounted as separate files and referenced by their path.
# =============================================================================


# -----------------------------------------------------------------------------
# 1. REQUIRED -- Microsoft 365 identity
#
# These values connect the relay to your tenant. The relay will not send mail
# until the first three are filled in. See docs/MICROSOFT-SETUP.md for how to
# create the app registration and the mailbox.
# -----------------------------------------------------------------------------

# Your Microsoft 365 tenant (directory) ID.
MAIL_RELAY_TENANT=

# The Application (client) ID of the app registration the relay signs in as.
MAIL_RELAY_CLIENT_ID=

# The mailbox all outgoing mail is sent from. Use a dedicated, unlicensed shared
# mailbox; every message the relay sends goes out as this address.
MAIL_SEND_MAILBOX=

# The Object ID of the enterprise application (in Entra: Enterprise applications
# > your app > Object ID). It is used only once, by powershell/setup-exchange.ps1,
# to grant the mailbox permission -- the running container never reads it. It is
# recorded here so re-running the setup script reuses the same identity. Getting
# this wrong is a common cause of "535 Authentication unsuccessful".
MAIL_RELAY_ENTERPRISE_APP_OBJECT_ID=


# -----------------------------------------------------------------------------
# 2. Alerts -- where the relay tells you something is wrong
#
# The relay only contacts you about real problems (a failed token, an expiring
# certificate). It never sends routine "all is well" mail.
# -----------------------------------------------------------------------------

# Email address that receives alerts and certificate-rotation proof messages.
# Strongly recommended -- without it, failures are visible only in the logs.
MAIL_ADMIN_EMAIL=

# Optional second alert channel: a URL that receives a JSON message for each
# problem. Worth setting because an email outage cannot announce itself by email.
# Treat the URL as a secret. Leave blank to disable.
MAIL_ALERT_WEBHOOK=


# -----------------------------------------------------------------------------
# 3. Sender identity -- how the "From" address and name appear
#
# By default every message is rewritten to come from MAIL_SEND_MAILBOX, keeping
# whatever display name the sending application used. These settings adjust that.
# -----------------------------------------------------------------------------

# How the From address is handled:
#   collapse (default) -- rewrite every message to come from MAIL_SEND_MAILBOX.
#   passthrough        -- let specific pre-approved addresses keep their own From
#                         address (listed below); everything else still collapses.
MAIL_SENDER_MODE=collapse

# Display name used when a sending application does not supply one of its own.
MAIL_SENDER_NAME_FALLBACK=Example notifications

# Who may appear as the sender:
#   off (default) -- accept mail from any connected client and rewrite it.
#   on            -- reject any From address that is not MAIL_SEND_MAILBOX or one
#                   you named below. (Who may CONNECT is set in section 4.)
MAIL_SENDER_ALLOWLIST=off

# Passthrough mode only: the addresses allowed to keep their own From address.
# Comma- or space-separated. Ignored in collapse mode.
MAIL_PASSTHROUGH_SENDERS=

# Optional: pin a fixed From address and display name for one application. Repeat
# the pair for each app, replacing APP with any label you like. See the examples/
# folder for ready-made Grafana, Gitea, Alertmanager, and Authelia entries.
# MAIL_SENDER_APP=app@relay.example.local
# MAIL_SENDER_NAME_APP=Example application


# -----------------------------------------------------------------------------
# 4. Inbound access -- who is allowed to connect to the relay
#
# Controls which clients may hand mail to the relay. The default trusts only the
# local Docker network, which is right for apps sharing a compose network.
# -----------------------------------------------------------------------------

# How connecting clients are authorized:
#   off         -- no external clients.
#   ip          -- trust clients on the local/allowed network (default).
#   smtp-auth   -- require a username and password.
#   ip-or-auth  -- trusted network OR a valid login.
#   ip-and-auth -- trusted network AND a valid login.
MAIL_INBOUND_AUTH=ip

# Require encryption on inbound connections: off | may | require. Leave blank to
# pick a safe default from MAIL_INBOUND_AUTH (encryption is required whenever a
# password is involved).
MAIL_INBOUND_TLS=

# Extra IP addresses or CIDR ranges allowed to connect, in addition to the
# auto-detected Docker network. Comma- or space-separated. Blank = local only.
MAIL_TRUSTED_NETWORKS=

# File of "username:password" lines, one per line. Needed only when
# MAIL_INBOUND_AUTH requires a login. Mounted as a secret, not stored here.
MAIL_SMTPD_USERS_FILE=/config/secrets/smtpd_users


# -----------------------------------------------------------------------------
# 5. Network and host identity
#
# The port the relay listens on and the names it uses. The defaults are
# internal-only and safe to leave unchanged unless a client checks TLS names.
# -----------------------------------------------------------------------------

# Port the relay listens on inside the container.
RELAY_PORT=2525

# Internal domain name. Sets Postfix's mydomain and the login realm. Internal
# only -- it need not be real, resolvable, or match your Microsoft 365 domain.
# Prefer a name containing a dot.
MAIL_RELAY_DOMAIN=relay.example.local

# Hostname the relay announces (its EHLO name, Received header, and the name on
# its self-signed inbound TLS certificate). Internal only. Set it to the exact
# address clients use ONLY if a client verifies the TLS hostname strictly.
MAIL_RELAY_HOSTNAME=postfix-m365-relay.relay.example.local

# Timezone for log timestamps (IANA name, e.g. America/New_York). Leave unset to
# use the container's /etc/localtime, which is UTC unless you bind-mount the
# host's /etc/localtime into the container.
#TZ=UTC


# -----------------------------------------------------------------------------
# 6. Testing
# -----------------------------------------------------------------------------

# Leave "no" in production. When "yes", the relay sends a real test email to
# MAIL_ADMIN_EMAIL on every health cycle (hourly) to prove mail actually reaches
# Microsoft. Useful during first setup -- but it means one email per hour, so
# turn it back off when done. All other health checks run regardless.
MAIL_VERIFY_SEND=no


# -----------------------------------------------------------------------------
# 7. Advanced
#
# Rarely needed, so kept out of this file. Upstream host, message size and rate
# limits, queue lifetime, certificate lifetimes, corporate TLS inspection,
# bring-your-own certificates, and push monitors are all documented in
# docs/CONFIGURATION.md.
# -----------------------------------------------------------------------------

# Pass any raw Postfix main.cf setting through by prefixing its name with
# POSTFIX_. Security-sensitive settings are always enforced by the relay and
# cannot be overridden this way. Example:
# POSTFIX_smtp_dns_support_level=dnssec
